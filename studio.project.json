{
  "$schema": "studio/schemas/project.schema.json",
  "schema": "studio.project",
  "version": 1,
  "id": "tien-nghich-2d",
  "name": "Tiên Nghịch 2D",
  "palette": {
    "file": "tools/generators/palette.json"
  },
  "sizeClasses": {
    "tile": {"sizes": [[16, 16]]},
    "character": {"sizes": [[32, 32]]},
    "weapon": {"sizes": [[24, 24], [32, 32]]},
    "boss": {"min": [64, 64], "max": [96, 96], "square": true},
    "icon": {"sizes": [[16, 16], [24, 24]]}
  },
  "rules": {
    "alpha": "binary",
    "outline": {"mode": "silhouette", "color": "palette", "borderIsEdge": false}
  },
  "frameKeys": {
    "ui": "ui/{id}/{clip}_none_{n}",
    "vfx": "vfx/{id}_{n}",
    "longtime": "longtime/{id}/{clip}_{direction}_{n}",
    "longtimeVfx": "longtime/{id}/{clip}_{palette}_{n}"
  },
  "directories": {
    "raw": {
      "characters": "assets/raw/characters",
      "environment": "assets/raw/environment_items",
      "longtime": "assets/raw/longtime"
    },
    "processed": {
      "core": "assets/processed",
      "longtime": "assets/processed_longtime"
    },
    "atlases": {
      "core": "assets/atlases",
      "longtime": "assets/atlases_longtime"
    },
    "fixtures": {
      "atlases": "assets/_fixtures/atlases/web",
      "pngs": "assets/_fixtures/pngs"
    },
    "revisions": ".inspector-revisions"
  },
  "atlasProfiles": {
    "web": {"limit": 2048, "padding": 0, "extrude": 0, "fixedSize": true},
    "mobile": {"limit": 1024, "padding": 2, "extrude": 1, "fixedSize": false}
  },
  "catalog": {
    "sources": [
      {"id": "core", "kind": "asset-manifest", "file": "assets/manifest.json", "processed": "core",
       "label": {"en": "Core assets", "vi": "Asset lõi"}},
      {
        "id": "longtime", "kind": "design-manifest", "file": "assets/manifest_longtime.json", "effects": "vfx.entries",
        "label": {"en": "Longtime assets", "vi": "Asset Longtime"}, "effectsLabel": {"en": "Longtime VFX", "vi": "VFX Longtime"},
        "processed": "longtime", "raw": "longtime",
        "budget": {
          "ceilings": "chunks", "page": "mobile.page", "bytesPerPixel": "mobile.bytes_per_pixel",
          "manifest": "assets/atlases_longtime/mobile/{chunk}/chunk-manifest.json"
        }
      },
      {
        "id": "vfx", "kind": "vfx-index", "file": "assets/processed/vfx/vfx_index.json",
        "label": {"en": "Core VFX", "vi": "VFX lõi"},
        "atlas": {"dir": "assets/atlases/web", "frameKey": "vfx"}
      },
      {
        "id": "audio", "kind": "audio-plan", "file": "assets/audio_manifest.json",
        "label": {"en": "Audio", "vi": "Âm thanh"},
        "evidence": {"packs": "assets/audio/packs", "masters": "assets/audio", "sources": "assets/audio/source"}
      }
    ]
  },
  "editable": {
    "overlay": "assets/approved-frames.json",
    "groups": [
      {
        "kind": "asset-animations", "source": "core", "category": "ui", "frameKey": "ui",
        "raw": "{output_path}{id}_{clip}_{n}.png", "processed": "assets/processed/{key}.png"
      },
      {"kind": "vfx-descriptor", "source": "vfx", "category": "vfx", "frameKey": "vfx"},
      {
        "kind": "processed-frames", "source": "core", "categories": ["player", "mob", "boss"],
        "keyMap": {"players": "characters", "mobs": "characters", "bosses": "characters"},
        "pivot": {"from": "file", "file": "anchor.json", "field": "anchor_px"},
        "publish": {"mode": "none", "reason": "Character frames live under players/, mobs/ and bosses/ but are packed as characters/…; the promotion bridge needs the frame key to equal the processed path, and character atlases carry no per-frame pivot yet. Edit, review and restore work; publishing is not wired."}
      },
      {
        "kind": "processed-frames", "source": "core", "categories": ["tileset", "weapon", "projectile", "prop"],
        "publish": {"mode": "none", "reason": "Their keys equal the atlas keys, but promotion into the atlases has only been verified for UI and VFX frames. Enable it here once a promotion test passes for the category."}
      },
      {
        "kind": "processed-frames", "source": "core", "categories": ["icon"], "keyMap": {"icons": "ui"},
        "publish": {"mode": "none", "reason": "Icons live under icons/ but are packed with the UI group (ui/…), so the frame key differs from the processed path the promotion bridge requires."}
      },
      {
        "kind": "processed-frames", "source": "longtime", "keyPrefix": "longtime/", "pivot": {"from": "profile", "field": "pivot_px"},
        "publish": {"mode": "none", "reason": "Longtime assets are packed into per-chunk atlases by the Longtime QA packer (qa_longtime.py), which does not read approved frames."}
      }
    ]
  },
  "ui": {
    "brand": {"mark": "仙", "subtitle": {"en": "Xianxia pixel-art workshop", "vi": "Xưởng pixel art tiên hiệp"}},
    "languages": ["en", "vi"],
    "theme": {
      "ink": "ink_01", "surface": "ink_02", "line": "ink_03", "muted": "ink_05", "text": "ink_06",
      "accent": "jade_04", "accentSoft": "jade_02", "gold": "bronze_04", "goldSoft": "bronze_06", "danger": "blood_05"
    },
    "categoryTabs": {
      "player": "characters", "pet": "characters", "npc": "characters", "mob": "characters", "boss": "characters",
      "tileset": "objects", "weapon": "objects", "projectile": "objects", "prop": "objects", "icon": "objects",
      "ui": "objects", "facility": "objects", "tower": "objects",
      "vfx": "vfx",
      "bgm": "audio", "combat": "audio", "progression_ui": "audio", "sfx": "audio"
    },
    "tabs": {
      "atlas": {
        "sets": [
          {
            "id": "core", "label": {"en": "Core atlases", "vi": "Atlas lõi"}, "atlases": "core", "layout": "{profile}", "profiles": ["web", "mobile"],
            "format": "frame-hash", "array": ["web"], "processed": "core",
            "keyMap": {"players": "characters", "mobs": "characters", "bosses": "characters", "icons": "ui"}, "skipSuffix": {"vfx": "_sheet"},
            "extraFiles": ["AssetKeys.ts", "mob-runtime.json"],
            "authority": {"build": {"command": "pack", "args": ["--output", "{out}"]}, "check": {"command": "packCheck", "args": ["--output", "{out}"]}}
          },
          {
            "id": "longtime", "label": {"en": "Longtime chunks", "vi": "Chunk Longtime"}, "atlases": "longtime", "layout": "{profile}/{chunk}", "profiles": ["web", "mobile"],
            "format": "chunk-hash", "profileOverrides": {"web": {"fixedSize": false}}, "design": {"profile": "mobile", "from": "mobile", "chunks": "chunks"},
            "chunks": {"crlf": ["abode", "interface"], "app": "tien-nghich-2d.qa_longtime", "manifestSchema": "tien-nghich-2d.longtime-chunk-atlas", "summaryFile": "chunk-manifest.json"},
            "authority": {"build": {"command": "qaLongtime", "args": ["--out-root", "{out}", "--ids", "{ids}"]}}
          }
        ],
        "export": {"tilesetCategories": ["tileset"], "pixelsPerUnit": 16},
        "ledger": {
          "agentOrigins": {"pixellab": {"kind": "retired-tool", "tool": "PixelLab"}},
          "originLogs": [
            {"origin": "retired-tool", "file": "assets/raw/characters/pixellab_log.json", "list": "entries", "id": "id", "fields": ["character_uuid", "fetched_utc", "tool"]},
            {"origin": "retired-tool", "file": "assets/raw/characters/pixellab_log_mobs.json", "list": "entries", "id": "id", "fields": ["character_uuid", "fetched_utc", "tool"]},
            {"origin": "retired-tool", "file": "assets/raw/characters/pixellab_log_bosses.json", "list": "entries", "id": "id", "fields": ["character_uuid", "fetched_utc", "tool"]},
            {"origin": "generator", "file": "assets/raw/environment_items/gen_items_weapons_log.json", "list": "files", "id": "id", "script": "tools/generators/gen_items_weapons.py"},
            {"origin": "generator", "file": "assets/raw/environment_items/tilesets/gen_tilesets_log.json", "list": "assets", "id": "id", "script": "tools/generators/gen_tilesets.py"},
            {"origin": "generator", "file": "assets/raw/environment_items/ui/gen_ui_icons_log.json", "list": "files", "id": "id", "scriptField": "script"}
          ],
          "descriptors": [{"source": "vfx", "file": "{descriptor}", "field": "spec", "origin": "tool-render", "tool": "spritefx", "evidence": ["docs/LESSONS_vfx_spritefx.md"]}],
          "assetRecords": ["provenance.json"],
          "rawDirs": {"longtime-vfx": "assets/raw/longtime/{id}"},
          "studioRecords": ["studio-submissions.jsonl", "forge/import.json"],
          "audio": {
            "singles": "assets/audio/{id}/provenance.json",
            "batches": {"root": "assets/audio/source", "file": "provenance.json", "list": "masters", "id": "id"}
          },
          "components": [
            {"id": "spritefx", "name": "SpriteFX", "role": {"en": "Renders the VFX sheets from a JSON effect spec", "vi": "Dựng sheet VFX từ đặc tả JSON"},
             "licence": "MIT", "pin": "e5867cc05f6e1dc6207b8e1c3c65cef75e6ba51a", "evidence": ["docs/SKILLS_INSTALLED.md", "assets/raw/longtime/lt_fx_gate_unseal/provenance.json"], "ships": "tool only; output carries no external rights (recorded in the VFX provenance)"},
            {"id": "ffmpeg", "name": "FFmpeg 6.1.1 (self-built)", "role": {"en": "Encodes the audio pack codecs", "vi": "Mã hóa codec cho gói audio"},
             "licence": null, "evidence": ["tools/scripts/build_ffmpeg_611_mac.sh", "docs/AUDIO_TOOLCHAIN_MAC.md"], "ships": "tool only; encoded files are shipped",
             "flag": "The build script configures libvorbis and does not pass --enable-gpl or --enable-nonfree. The resulting licence of the build is for a human to confirm."},
            {"id": "spine-animation-ai", "name": "spine-animation-ai skill", "role": {"en": "Experimental rig builder used for one scratch courtyard bell", "vi": "Công cụ dựng rig thử cho một chuông ở sân"},
             "licence": "PolyForm Noncommercial 1.0.0", "pin": "702b71689cac826efee942ee4564fef9560d6ef8", "evidence": ["docs/SKILLS_INSTALLED.md", ".claude/skills/spine-animation/SKILL.md"], "mustNotShip": true,
             "ships": "must not ship", "flag": "Noncommercial licence. Keep it out of the shipping pipeline and out of shipped builds unless a human decides otherwise."},
            {"id": "assetcat", "name": "AssetCat", "role": {"en": "Searches an external asset library and records licences", "vi": "Tìm trong thư viện asset ngoài và ghi giấy phép"},
             "licence": "MIT", "pin": "8784327edb240e3b940bd28901c6f994beaf78cc", "evidence": ["docs/SKILLS_INSTALLED.md", "docs/ASSET_PROVENANCE.md"], "ships": "tool only; no third-party library asset is recorded as used"}
          ],
          "thirdPartySources": "assets/sources.toml",
          "fontScan": {"roots": ["studio", "preview-app", "assets"], "extensions": [".ttf", ".otf", ".woff", ".woff2"]}
        }
      },
      "characters": {
        "categories": ["player", "mob", "boss", "npc", "pet"],
        "facings": ["south", "east", "north", "west"],
        "defaultFrameMs": 100,
        "rawRoots": ["assets/raw/characters", "assets/raw/longtime"],
        "rigs": ["assets/experiments/forge_bakeoff/{id}/rig.json"],
        "experiments": ["assets/experiments/forge_bakeoff/{id}"],
        "bodyPlans": {"pet": "quadruped", "npc": "biped", "player": "biped", "mob": "biped", "boss": "biped", "boss_large": "biped"}
      },
      "sandbox": {"scenesDir": "assets/scenes"}
    },
    "vfx": {
      "floors": [
        {"id": "grey", "color": "ink_04"},
        {"id": "court", "color": "ink_03", "joint": "ink_02"},
        {"id": "dark", "color": "ink_02"}
      ],
      "roundsDir": "tools/generators/vfx_specs/history",
      "rubricDoc": "docs/LESSONS_vfx_spritefx.md",
      "longtimeDoc": "docs/LONGTIME_VFX.md"
    },
    "tools": [
      {"id": "arena", "href": "previewer.html?tab=arena", "tab": "sandbox",
       "label": {"en": "Play Arena", "vi": "Đấu trường thử"}, "note": {"en": "Playable arena with blob-47 rooms", "vi": "Đấu trường chơi được, phòng blob-47"}},
      {"id": "inspector", "href": "previewer.html?tab=inspector", "tab": "characters",
       "label": {"en": "Asset Inspector", "vi": "Trình xem asset"}, "note": {"en": "Core catalog, frame editor and review", "vi": "Danh mục lõi, sửa frame và duyệt"}},
      {"id": "library", "href": "library.html#art", "tab": "atlas",
       "label": {"en": "Longtime library", "vi": "Thư viện Longtime"}, "note": {"en": "Delivered Longtime atlas frames", "vi": "Frame atlas Longtime đã giao"}},
      {"id": "audio-pilot", "href": "library.html#audio", "tab": "audio",
       "label": {"en": "Audio pilot", "vi": "Audio thử"}, "note": {"en": "Approved pilot music and effects", "vi": "Nhạc và hiệu ứng thử đã duyệt"}},
      {"id": "drowned-court", "href": "blood-sea/index.html", "tab": "sandbox",
       "label": {"en": "Drowned Court", "vi": "Thủy Cung Chìm"}, "note": {"en": "Blood Sea boss encounter", "vi": "Trận boss Huyết Hải"}},
      {"id": "evening-bell", "href": "courtyard/", "tab": "sandbox",
       "label": {"en": "Evening Bell", "vi": "Chuông Chiều"}, "note": {"en": "Courtyard bell trial", "vi": "Thử chuông ở sân"}}
    ]
  },
  "figures": {
    "humanoid": {
      "description": "Upright characters with a head, a torso and two legs: the shipped players, and humanoid mobs and NPCs. Head share is head height over figure height; every length of the guide is a fraction of the figure height.",
      "measured": "six shipped 32x32 humanoids (wl_blood_foundation, wl_extreme_jing, wl_outer_disciple, wl_qi_condensation, mob_courtyard_guard, mob_rogue_disciple), idle and walk frames facing south in assets/processed, measured with studio/forge/figure measureFigure: head share (head height over figure height, where a neck shows) 0.31 to 0.38 for nine of eleven frames, one frame 0.50 and one 0.11 (a hat), median 0.37; leg width in the bottom rows (median run of opaque pixels) 4 to 9 px, never below 4; widest row 0.52 to 0.69 of the height; accent colours 5 to 20 px per palette id (blood, bronze, jade). The minimum limb width is set one pixel under the thinnest shipped figure.",
      "profiles": ["player", "npc", "mob"],
      "headToBody": {"min": 0.28, "max": 0.52, "target": 0.37},
      "minLimbWidthPx": 3,
      "accentMinPixels": 6,
      "guide": {"headWidth": 0.42, "bodyWidth": 0.58, "legWidth": 0.14, "legGap": 0.07}
    }
  },
  "adapters": {
    "interpreter": {"command": "tools/.venvs/project/bin/python", "args": ["-I"]},
    "commands": {
      "validatePalette": {"script": "tools/scripts/validate_palette.py", "args": ["{path}"]},
      "qa": {"script": "tools/scripts/qa_assets.py", "args": []},
      "qaLongtime": {"script": "tools/scripts/qa_longtime.py", "args": []},
      "pack": {"script": "tools/scripts/pack_atlases.py", "args": []},
      "packCheck": {"script": "tools/scripts/pack_atlases.py", "args": ["--check"]}
    },
    "generators": {
      "primitives": {
        "script": "tools/generators/studio_primitives.py",
        "description": "Primitive sprites on the project palette: diamond, disc, ring, cross, star, drop or shard, outlined, one or more pulsing frames. Writes <clip>_<direction>_<n>.png.",
        "args": ["--out", "{out}", "--palette", "{palette}", "--shape", "{shape}", "--size", "{size}", "--fill", "{fill}", "--accent", "{accent}",
          "--clip", "{clip}", "--direction", "{direction}", "--frames", "{frames}", "--seed", "{seed}"],
        "params": {
          "shape": {"type": "string", "enum": ["diamond", "disc", "ring", "cross", "star", "drop", "shard"], "description": "The silhouette."},
          "size": {"type": "integer", "minimum": 8, "maximum": 96, "default": 16, "description": "Canvas side in pixels; must equal the asset's native size."},
          "fill": {"type": "string", "pattern": "^[a-z]+_[0-9]{2}$", "default": "jade_04", "description": "Palette id of the body colour."},
          "accent": {"type": "string", "pattern": "^[a-z]+_[0-9]{2}$", "default": "bronze_04", "description": "Palette id of the highlight speckle."},
          "clip": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,23}$", "default": "glyph", "description": "Clip name in the file names."},
          "direction": {"type": "string", "enum": ["none", "south", "west", "north", "east"], "default": "none", "description": "Direction in the file names."},
          "frames": {"type": "integer", "minimum": 1, "maximum": 12, "default": 1, "description": "Frame count; more than one pulses the shape."}
        },
        "seed": {"default": 1, "maximum": 4294967295},
        "timeoutSec": 30
      }
    },
    "vfx": {
      "interpreter": {"command": "tools/.venvs/spritefx/bin/python", "args": ["-I", "-B"]},
      "clone": "tools/skills/spritefx",
      "palettes": {"tien_nghich_40": "tools/generators/vfx_specs/palettes/tien_nghich_40.json"},
      "timeoutSec": 120
    }
  }
}
