{
  "$schema": "studio/schemas/project.schema.json",
  "schema": "studio.project",
  "version": 1,
  "id": "tien-nghich-2d",
  "name": "Tiên Nghịch 2D",
  "palette": {
    "file": "tools/generators/palette.json"
  },
  "sizeClasses": {
    "tile": {"sizes": [[16, 16]]},
    "character": {"sizes": [[32, 32]]},
    "weapon": {"sizes": [[24, 24], [32, 32]]},
    "boss": {"min": [64, 64], "max": [96, 96], "square": true},
    "icon": {"sizes": [[16, 16], [24, 24]]}
  },
  "rules": {
    "alpha": "binary",
    "outline": {"mode": "silhouette", "color": "palette", "borderIsEdge": false}
  },
  "frameKeys": {
    "ui": "ui/{id}/{clip}_none_{n}",
    "vfx": "vfx/{id}_{n}",
    "longtime": "longtime/{id}/{clip}_{direction}_{n}",
    "longtimeVfx": "longtime/{id}/{clip}_{palette}_{n}"
  },
  "directories": {
    "raw": {
      "characters": "assets/raw/characters",
      "environment": "assets/raw/environment_items",
      "longtime": "assets/raw/longtime"
    },
    "processed": {
      "core": "assets/processed",
      "longtime": "assets/processed_longtime"
    },
    "atlases": {
      "core": "assets/atlases",
      "longtime": "assets/atlases_longtime"
    },
    "fixtures": {
      "atlases": "assets/_fixtures/atlases/web",
      "pngs": "assets/_fixtures/pngs"
    },
    "revisions": ".inspector-revisions"
  },
  "atlasProfiles": {
    "web": {"limit": 2048, "padding": 0, "extrude": 0, "fixedSize": true},
    "mobile": {"limit": 1024, "padding": 2, "extrude": 1, "fixedSize": false}
  },
  "catalog": {
    "sources": [
      {"id": "core", "kind": "asset-manifest", "file": "assets/manifest.json", "processed": "core",
       "label": {"en": "Core assets", "vi": "Asset lõi"}},
      {
        "id": "longtime", "kind": "design-manifest", "file": "assets/manifest_longtime.json", "effects": "vfx.entries",
        "label": {"en": "Longtime assets", "vi": "Asset Longtime"}, "effectsLabel": {"en": "Longtime VFX", "vi": "VFX Longtime"},
        "processed": "longtime", "raw": "longtime",
        "budget": {
          "ceilings": "chunks", "page": "mobile.page", "bytesPerPixel": "mobile.bytes_per_pixel",
          "manifest": "assets/atlases_longtime/mobile/{chunk}/chunk-manifest.json"
        }
      },
      {
        "id": "vfx", "kind": "vfx-index", "file": "assets/processed/vfx/vfx_index.json",
        "label": {"en": "Core VFX", "vi": "VFX lõi"},
        "atlas": {"dir": "assets/atlases/web", "frameKey": "vfx"}
      },
      {
        "id": "audio", "kind": "audio-plan", "file": "assets/audio_manifest.json",
        "label": {"en": "Audio", "vi": "Âm thanh"},
        "evidence": {"packs": "assets/audio/packs", "masters": "assets/audio", "sources": "assets/audio/source"}
      }
    ]
  },
  "editable": {
    "overlay": "assets/approved-frames.json",
    "groups": [
      {
        "kind": "asset-animations", "source": "core", "category": "ui", "frameKey": "ui",
        "raw": "{output_path}{id}_{clip}_{n}.png", "processed": "assets/processed/{key}.png"
      },
      {"kind": "vfx-descriptor", "source": "vfx", "category": "vfx", "frameKey": "vfx"},
      {
        "kind": "processed-frames", "source": "core", "categories": ["player", "mob", "boss"],
        "keyMap": {"players": "characters", "mobs": "characters", "bosses": "characters"},
        "pivot": {"from": "file", "file": "anchor.json", "field": "anchor_px"},
        "publish": {"mode": "none", "reason": "Character frames live under players/, mobs/ and bosses/ but are packed as characters/…; the promotion bridge needs the frame key to equal the processed path, and character atlases carry no per-frame pivot yet. Edit, review and restore work; publishing is not wired."}
      },
      {
        "kind": "processed-frames", "source": "core", "categories": ["tileset", "weapon", "projectile", "prop"],
        "publish": {"mode": "none", "reason": "Their keys equal the atlas keys, but promotion into the atlases has only been verified for UI and VFX frames. Enable it here once a promotion test passes for the category."}
      },
      {
        "kind": "processed-frames", "source": "core", "categories": ["icon"], "keyMap": {"icons": "ui"},
        "publish": {"mode": "none", "reason": "Icons live under icons/ but are packed with the UI group (ui/…), so the frame key differs from the processed path the promotion bridge requires."}
      },
      {
        "kind": "processed-frames", "source": "longtime", "keyPrefix": "longtime/", "pivot": {"from": "profile", "field": "pivot_px"},
        "publish": {"mode": "none", "reason": "Longtime assets are packed into per-chunk atlases by the Longtime QA packer (qa_longtime.py), which does not read approved frames."}
      }
    ]
  },
  "ui": {
    "brand": {"mark": "仙", "subtitle": {"en": "Xianxia pixel-art workshop", "vi": "Xưởng pixel art tiên hiệp"}},
    "languages": ["en", "vi"],
    "theme": {
      "ink": "ink_01", "surface": "ink_02", "line": "ink_03", "muted": "ink_05", "text": "ink_06",
      "accent": "jade_04", "accentSoft": "jade_02", "gold": "bronze_04", "goldSoft": "bronze_06", "danger": "blood_05"
    },
    "categoryTabs": {
      "player": "characters", "pet": "characters", "npc": "characters", "mob": "characters", "boss": "characters",
      "tileset": "objects", "weapon": "objects", "projectile": "objects", "prop": "objects", "icon": "objects",
      "ui": "objects", "facility": "objects", "tower": "objects",
      "vfx": "vfx",
      "bgm": "audio", "combat": "audio", "progression_ui": "audio", "sfx": "audio"
    },
    "tabs": {
      "characters": {
        "categories": ["player", "mob", "boss", "npc", "pet"],
        "facings": ["south", "east", "north", "west"],
        "defaultFrameMs": 100,
        "rawRoots": ["assets/raw/characters", "assets/raw/longtime"],
        "rigs": ["assets/experiments/forge_bakeoff/{id}/rig.json"],
        "experiments": ["assets/experiments/forge_bakeoff/{id}"],
        "bodyPlans": {"pet": "quadruped", "npc": "biped", "player": "biped", "mob": "biped", "boss": "biped", "boss_large": "biped"}
      }
    },
    "tools": [
      {"id": "arena", "href": "previewer.html?tab=arena", "tab": "sandbox",
       "label": {"en": "Play Arena", "vi": "Đấu trường thử"}, "note": {"en": "Playable arena with blob-47 rooms", "vi": "Đấu trường chơi được, phòng blob-47"}},
      {"id": "inspector", "href": "previewer.html?tab=inspector", "tab": "characters",
       "label": {"en": "Asset Inspector", "vi": "Trình xem asset"}, "note": {"en": "Core catalog, frame editor and review", "vi": "Danh mục lõi, sửa frame và duyệt"}},
      {"id": "library", "href": "library.html#art", "tab": "atlas",
       "label": {"en": "Longtime library", "vi": "Thư viện Longtime"}, "note": {"en": "Delivered Longtime atlas frames", "vi": "Frame atlas Longtime đã giao"}},
      {"id": "audio-pilot", "href": "library.html#audio", "tab": "audio",
       "label": {"en": "Audio pilot", "vi": "Audio thử"}, "note": {"en": "Approved pilot music and effects", "vi": "Nhạc và hiệu ứng thử đã duyệt"}},
      {"id": "drowned-court", "href": "blood-sea/index.html", "tab": "sandbox",
       "label": {"en": "Drowned Court", "vi": "Thủy Cung Chìm"}, "note": {"en": "Blood Sea boss encounter", "vi": "Trận boss Huyết Hải"}},
      {"id": "evening-bell", "href": "courtyard/", "tab": "sandbox",
       "label": {"en": "Evening Bell", "vi": "Chuông Chiều"}, "note": {"en": "Courtyard bell trial", "vi": "Thử chuông ở sân"}}
    ]
  },
  "adapters": {
    "interpreter": {"command": "tools/.venvs/project/bin/python", "args": ["-I"]},
    "commands": {
      "validatePalette": {"script": "tools/scripts/validate_palette.py", "args": ["{path}"]},
      "qa": {"script": "tools/scripts/qa_assets.py", "args": []},
      "qaLongtime": {"script": "tools/scripts/qa_longtime.py", "args": []},
      "pack": {"script": "tools/scripts/pack_atlases.py", "args": []},
      "packCheck": {"script": "tools/scripts/pack_atlases.py", "args": ["--check"]}
    }
  }
}
