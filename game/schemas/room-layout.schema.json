{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tien-nghich-2d/schemas/room-layout.schema.json",
  "title": "content/rooms/<room id>.yaml (parsed): the layout of one room of content/tables/rooms.csv",
  "type": "object", "additionalProperties": false, "required": ["id", "size", "player_start", "grid", "doors", "props", "waves"],
  "properties": {
    "id": { "type": "string", "pattern": "^room_[a-z0-9_]+$" },
    "size": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "integer", "minimum": 8, "maximum": 128 } },
    "player_start": { "$ref": "#/$defs/cell" },
    "grid": { "type": "array", "minItems": 8, "items": { "type": "string", "pattern": "^[#.~D]+$" }, "description": "Rows of tiles. # wall (block), . floor, ~ blood pool (walkable; the lurker's home), D door cell (blocks while the door is locked)." },
    "doors": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["side", "role", "to"], "properties": { "side": { "enum": ["west", "east"] }, "role": { "enum": ["entry", "exit"], "description": "entry: closes behind the player when the room starts. exit: locked until every wave is cleared." }, "to": { "type": "string", "pattern": "^room_[a-z0-9_]+$" } } } },
    "props": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "at"], "properties": { "id": { "type": "string", "pattern": "^prop_[a-z0-9_]+$" }, "at": { "$ref": "#/$defs/cell" }, "to": { "type": "string", "pattern": "^room_[a-z0-9_]+$", "description": "teleport_array only: the room it leads to." } } } },
    "waves": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["spawns"], "properties": { "spawns": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "object", "additionalProperties": false, "required": ["mob", "at"], "properties": { "mob": { "type": "string", "pattern": "^(mob|boss)_[a-z0-9_]+$" }, "at": { "$ref": "#/$defs/cell" } } } } } }, "description": "Wave 1 spawns when the room starts; each next wave when the previous one is dead. The room is cleared after the last." }
  },
  "$defs": { "cell": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "integer", "minimum": 0 }, "description": "[column, row] in tiles." } }
}
