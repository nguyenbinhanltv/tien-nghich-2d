# Third-party agent-skill clones are NOT vendored. Re-create with tools/scripts/fetch_skills.sh
# (pinned SHAs in docs/SKILLS_INSTALLED.md). Per-clone .venv / caches stay local.
tools/skills/*/
!tools/skills/README.md
__pycache__/
*.pyc
.venv/
/.inspector-revisions/
# Local audio codec toolchain builds (tools/scripts/build_ffmpeg_611_mac.sh); also matches the worktree symlink.
tools/.toolchains

# game/ (Vite + TypeScript): installs and outputs stay local; its own game/.gitignore says the same.
game/node_modules/
game/dist/
game/dist-content/
