{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "studio.motion.library",
  "type": "object",
  "required": ["schema", "version", "bodyPlan", "archetypes", "templates"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "studio.motion.library"},
    "version": {"const": 1},
    "bodyPlan": {"type": "string", "minLength": 1},
    "archetypes": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/definitions/archetype"}},
    "templates": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/definitions/binding"}}
  },
  "definitions": {
    "archetype": {
      "type": "object", "required": ["tracks"], "additionalProperties": false,
      "properties": {"loop": {"type": "boolean"}, "tracks": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/track"}}}
    },
    "binding": {
      "type": "object", "required": ["use"], "additionalProperties": false,
      "properties": {"use": {"type": "string", "minLength": 1}, "scale": {"type": "number", "minimum": 0}}
    },
    "track": {
      "type": "object", "required": ["id", "target"], "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "target": {"$ref": "#/definitions/target"},
        "channel": {"type": "string"},
        "curve": {"$ref": "#/definitions/curve"},
        "scale": {"type": "number"},
        "groups": {"type": "integer", "minimum": 1},
        "gait": {"type": "object", "additionalProperties": false, "properties": {
          "groups": {"type": "integer", "minimum": 1}, "planted": {"type": "number", "minimum": 0},
          "stride": {"type": "number", "minimum": 0}, "lift": {"type": "number", "minimum": 0}}},
        "contactPose": {"type": "object", "additionalProperties": false, "properties": {
          "shift": {"type": "number", "minimum": 0}, "maxShift": {"type": "number", "minimum": 0},
          "dip": {"type": "number", "minimum": 0}, "dipKeys": {"type": "integer", "minimum": 1}}}
      }
    },
    "target": {
      "type": "object", "additionalProperties": false,
      "properties": {"role": {"type": "string"}, "roles": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "phase": {"type": "integer", "minimum": 0}}
    },
    "curve": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "const": {"type": "number"},
        "wave": {"type": "object", "additionalProperties": false, "properties": {
          "amp": {"type": "number"}, "cycles": {"type": "number"}, "phase": {"type": "number"}, "offset": {"type": "number"}}},
        "keyframes": {"type": "array", "minItems": 1, "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}}},
        "keys": {"type": "array", "minItems": 1, "items": {"type": "number"}}
      }
    }
  }
}
