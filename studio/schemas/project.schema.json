{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "studio.project.schema.json",
  "title": "Studio project pack",
  "description": "Everything project-specific that the studio core, server and client read. Paths are relative to the project root.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "id",
    "name",
    "palette",
    "sizeClasses",
    "rules",
    "frameKeys",
    "directories",
    "atlasProfiles",
    "catalog",
    "editable",
    "adapters"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema": {
      "const": "studio.project"
    },
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "palette": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file"
      ],
      "properties": {
        "file": {
          "$ref": "#/$defs/path"
        }
      }
    },
    "sizeClasses": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/sizeClass"
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alpha",
        "outline"
      ],
      "properties": {
        "alpha": {
          "enum": [
            "binary"
          ]
        },
        "outline": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "color",
            "borderIsEdge"
          ],
          "properties": {
            "mode": {
              "enum": [
                "silhouette",
                "none"
              ]
            },
            "color": {
              "anyOf": [
                {
                  "const": "palette"
                },
                {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                }
              ]
            },
            "borderIsEdge": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "frameKeys": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "directories": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw",
        "processed",
        "atlases",
        "revisions"
      ],
      "properties": {
        "raw": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/path"
          }
        },
        "processed": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/path"
          }
        },
        "atlases": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/path"
          }
        },
        "fixtures": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/path"
          }
        },
        "approvals": {
          "$ref": "#/$defs/path",
          "description": "Optional directory of tracked, hash-tied records of human approvals stated outside the studio (art_approvals.json). The Review tab reads it and never writes it."
        },
        "revisions": {
          "type": "string",
          "pattern": "^[a-z0-9._-]+$",
          "description": "Single lower-case directory name at the project root; the server hides it and the store refuses it as a library."
        }
      }
    },
    "atlasProfiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "limit",
          "padding",
          "extrude",
          "fixedSize"
        ],
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1
          },
          "padding": {
            "type": "integer",
            "minimum": 0
          },
          "extrude": {
            "type": "integer",
            "minimum": 0
          },
          "fixedSize": {
            "type": "boolean"
          }
        }
      }
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sources"
      ],
      "properties": {
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "file"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9_]+$"
              },
              "kind": {
                "enum": [
                  "asset-manifest",
                  "design-manifest",
                  "vfx-index",
                  "audio-plan"
                ]
              },
              "file": {
                "$ref": "#/$defs/path"
              },
              "effects": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_]+(\\.[A-Za-z0-9_]+)*$"
              },
              "processed": {
                "type": "string",
                "description": "Key into directories.processed holding this source's processed frames."
              },
              "budget": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "ceilings",
                  "page",
                  "bytesPerPixel",
                  "manifest"
                ],
                "description": "Per-chunk atlas budget of a design-manifest: dotted paths to the ceilings, page size and bytes per pixel, and a {chunk} template for each chunk's atlas manifest.",
                "properties": {
                  "ceilings": {
                    "type": "string"
                  },
                  "page": {
                    "type": "string"
                  },
                  "bytesPerPixel": {
                    "type": "string"
                  },
                  "manifest": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "atlas": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "dir",
                  "frameKey"
                ],
                "description": "Where a vfx-index finds its packed atlases (hash-format JSON) and which frameKeys template names its frames.",
                "properties": {
                  "dir": {
                    "$ref": "#/$defs/path"
                  },
                  "frameKey": {
                    "type": "string"
                  }
                }
              },
              "evidence": {
                "type": "object",
                "additionalProperties": false,
                "description": "Where an audio-plan finds packed packs (*/pack.json), authored masters, and per-batch source folders (named like the master's folder) for provenance pointers.",
                "properties": {
                  "packs": {
                    "$ref": "#/$defs/path"
                  },
                  "masters": {
                    "$ref": "#/$defs/path"
                  },
                  "sources": {
                    "$ref": "#/$defs/path"
                  }
                }
              },
              "label": {
                "type": "object",
                "required": [
                  "en"
                ],
                "properties": {
                  "en": {
                    "type": "string"
                  },
                  "vi": {
                    "type": "string"
                  }
                }
              },
              "effectsLabel": {
                "type": "object",
                "required": [
                  "en"
                ],
                "properties": {
                  "en": {
                    "type": "string"
                  },
                  "vi": {
                    "type": "string"
                  }
                }
              },
              "raw": {
                "type": "string",
                "description": "Key into directories.raw holding this source's per-asset source folders."
              },
              "idPattern": {
                "type": "string",
                "description": "design-manifest: anchored regex a studio-planned asset id must match."
              },
              "idHint": {
                "type": "string",
                "description": "design-manifest: an example id shown when idPattern rejects one."
              },
              "keyBase": {
                "type": "string",
                "description": "design-manifest: frame-key base when no frameKeys.sprites template is given (default: the source id)."
              },
              "frameKeys": {
                "type": "object",
                "additionalProperties": false,
                "description": "design-manifest: names of the pack frameKeys templates for its sprites and its effects.",
                "properties": {
                  "sprites": {
                    "type": "string"
                  },
                  "effects": {
                    "type": "string"
                  }
                }
              },
              "atlases": {
                "type": "string",
                "description": "Key into directories.atlases holding this source's atlases (default: the processed key)."
              },
              "processedSubdir": {
                "type": "string",
                "description": "vfx-index: sub-directory of the processed directory holding the flat frame files."
              }
            }
          }
        },
        "categories": {
          "type": "object",
          "description": "Per-category conventions: the processed sub-directory (group), the atlas key prefix, whether the silhouette must carry the outline colour, whether frames may be empty (an effect fading to nothing).",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "group": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "keyPrefix": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "outline": {
                "type": "boolean"
              },
              "emptyOk": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "editable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "overlay",
        "groups"
      ],
      "properties": {
        "overlay": {
          "$ref": "#/$defs/path"
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "kind",
              "source"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "asset-animations",
                  "vfx-descriptor",
                  "processed-frames"
                ]
              },
              "source": {
                "type": "string"
              },
              "category": {
                "type": "string"
              },
              "frameKey": {
                "type": "string"
              },
              "raw": {
                "type": "string"
              },
              "processed": {
                "type": "string"
              },
              "categories": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                },
                "description": "processed-frames: only catalog entries of these categories (default: all of the source)."
              },
              "keyPrefix": {
                "type": "string",
                "description": "processed-frames: prepended to each frame key."
              },
              "keyMap": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "processed-frames: rename the first directory of the processed path in the key (e.g. the atlas key group)."
              },
              "pivot": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "from"
                ],
                "description": "processed-frames: default pivot; falls back to the frame centre.",
                "properties": {
                  "from": {
                    "enum": [
                      "center",
                      "file",
                      "profile"
                    ]
                  },
                  "file": {
                    "type": "string"
                  },
                  "field": {
                    "type": "string"
                  }
                }
              },
              "publish": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "mode"
                ],
                "description": "Whether an approved revision can be published into atlases. mode \"none\" must say why.",
                "properties": {
                  "mode": {
                    "enum": [
                      "atlas",
                      "none"
                    ]
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    "policy": {
      "description": "Rules the studio enforces on agents, with the numbers kept in the pack. Optional; absent means no limit.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stop": {
          "description": "Stop policy: at most maxFixRounds fix rounds per asset per review request; noProgressRounds rounds in a row without measurable progress ends the work and asks the human.",
          "type": "object",
          "additionalProperties": false,
          "required": ["maxFixRounds", "noProgressRounds"],
          "properties": {"maxFixRounds": {"type": "integer", "minimum": 1, "maximum": 20}, "noProgressRounds": {"type": "integer", "minimum": 1, "maximum": 20}}
        }
      }
    },
    "agentGuidance": {
      "description": "Text for agents, kept in the pack so the studio holds no project wording: pixel-art rules sent at MCP initialize, and the style words of image-sheet prompts.",
      "type": "object",
      "additionalProperties": false,
      "required": ["rules"],
      "properties": {
        "rules": {"type": "array", "minItems": 1, "maxItems": 24, "items": {"type": "string", "minLength": 1, "maxLength": 400}},
        "prompt": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "style": {"type": "string", "maxLength": 400},
            "camera": {"type": "string", "maxLength": 200},
            "light": {"type": "string", "maxLength": 200}
          }
        }
      }
    },
    "references": {
      "description": "Style-locked entities: an approved image and a description paragraph that studio_template_get hands out and every sheet prompt for these assets must carry verbatim. One entry may cover a family of assets.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["assets", "image", "sha256", "description", "approved"],
        "properties": {
          "assets": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "image": {"$ref": "#/$defs/path"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "description": {"type": "string", "minLength": 20, "maxLength": 2000},
          "approved": {
            "type": "object",
            "additionalProperties": false,
            "required": ["by", "at"],
            "properties": {"by": {"type": "string", "minLength": 1}, "at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}, "note": {"type": "string"}}
          }
        }
      }
    },
    "figures": {
      "description": "Readability guides for characters at native size: what the sheet template shows the artist and what studio_process checks. Keyed by a guide name; each lists the manifest profiles it applies to. Optional.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["profiles", "headToBody", "minLimbWidthPx", "accentMinPixels"],
        "properties": {
          "description": {"type": "string"},
          "measured": {"type": "string", "description": "Where the numbers come from (which shipped assets were measured)."},
          "profiles": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "headToBody": {
            "type": "object",
            "additionalProperties": false,
            "required": ["min", "max", "target"],
            "properties": {"min": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}, "max": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}, "target": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}}
          },
          "minLimbWidthPx": {"type": "integer", "minimum": 1, "maximum": 16},
          "accentMinPixels": {"type": "integer", "minimum": 1, "maximum": 64},
          "guide": {
            "type": "object",
            "additionalProperties": false,
            "required": ["headWidth", "bodyWidth", "legWidth", "legGap"],
            "properties": {"headWidth": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}, "bodyWidth": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}, "legWidth": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}, "legGap": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}}
          }
        }
      }
    },
    "motion": {
      "description": "Motion measurement and clip lint. `roles` maps a clip name to the beat it carries (a clip called telegraph is a tell); `lint` holds the thresholds (every key optional, studio defaults apply). Calibrated on the shipped roster: see the `measured` note.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "measured": {"type": "string", "description": "Where the numbers come from."},
        "roles": {"type": "object", "additionalProperties": {"enum": ["tell", "hit", "step"]}},
        "lint": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "orphanMaxPx": {"type": "integer", "minimum": 1, "maximum": 8, "description": "A separate group of opaque pixels this small is an orphan pixel."},
            "fragmentMaxPx": {"type": "integer", "minimum": 1, "maximum": 64, "description": "A separate group above orphanMaxPx and up to this size is a detached fragment; larger separate groups are parts of the design."},
            "nearDuplicate": {"type": "object", "additionalProperties": false, "properties": {
              "ratio": {"type": "number", "minimum": 0, "maximum": 1, "description": "Neighbouring frames that differ by at most this share of the clip's mean opaque pixels are near-duplicates."},
              "minPx": {"type": "integer", "minimum": 0, "maximum": 64, "description": "Floor for the limit, in pixels."}}},
            "cadence": {"type": "object", "additionalProperties": false, "properties": {
              "ratio": {"type": "number", "minimum": 1, "maximum": 50, "description": "A step that changes more than this many times the median step is a jump."},
              "floorPx": {"type": "integer", "minimum": 1, "maximum": 512, "description": "The median is never taken below this, so a quiet clip is not flagged for a small absolute change."}}},
            "tell": {"type": "object", "additionalProperties": false, "properties": {
              "minMs": {"type": "integer", "minimum": 1, "maximum": 5000, "description": "A telegraph shorter than this is too short to read."},
              "minFrames": {"type": "integer", "minimum": 1, "maximum": 16}}}
          }
        }
      }
    },
    "rubric": {
      "description": "The fixed review rubric: one row per criterion an agent fills in (expectation, observation, confidence, evidence) before asking a human to review. Optional.",
      "type": "object",
      "additionalProperties": false,
      "required": ["criteria"],
      "properties": {
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "expectation"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$"},
              "label": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}, "required": ["en"]},
              "expectation": {"type": "string", "minLength": 5, "maxLength": 400},
              "mandatory": {"type": "boolean", "description": "A failed (or unknown) mandatory criterion fails the rubric whatever the others say."}
            }
          }
        },
        "minConfidence": {"type": "number", "minimum": 0, "maximum": 1, "description": "An observation below this confidence counts as unknown, never as a pass."}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional. Names the accepted baseline: shipped art that predates the studio and has no review record. Anything not covered here and not approved by a human record reads as awaiting review.",
      "properties": {
        "baseline": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file", "roots"],
          "properties": {
            "file": {"$ref": "#/$defs/path", "description": "Record of {directories: {<frame directory>: <digest of its PNG names and sha256s>}}, written by `node studio/baseline.mjs --write`. A frame is baseline only while its directory still digests to the recorded value."},
            "roots": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/path"}, "description": "Directories whose PNG directories the record covers when it is (re)written."}
          }
        }
      }
    },
    "adapters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interpreter",
        "commands"
      ],
      "properties": {
        "interpreter": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "command"
          ],
          "properties": {
            "command": {
              "$ref": "#/$defs/path"
            },
            "args": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "commands": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "script"
            ],
            "properties": {
              "script": {
                "$ref": "#/$defs/path"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "generators": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/generator"
          }
        },
        "vfx": {
          "$ref": "#/$defs/vfxAdapter"
        }
      }
    },
    "forge": {
      "type": "object",
      "additionalProperties": false,
      "description": "Defaults the forge reads from the pack.",
      "properties": {
        "pixelize": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "hold": {
              "type": "object",
              "additionalProperties": false,
              "required": ["margin"],
              "description": "Sequence-aware palette snapping: a pixel keeps its previous palette entry when the new source colour is within margin of the best entry's distance.",
              "properties": {
                "enabled": {"type": "boolean"},
                "margin": {"type": "number", "minimum": 0, "maximum": 450},
                "metric": {"enum": ["rgb", "redmean"]},
                "search": {"type": "integer", "minimum": 0, "maximum": 4},
                "laps": {"type": "integer", "minimum": 1, "maximum": 4},
                "maxChromaGain": {"type": "number", "minimum": 0, "maximum": 255}
              }
            }
          }
        }
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "brand",
        "theme",
        "categoryTabs",
        "tools"
      ],
      "description": "Look and navigation of the studio shell. Colours are palette ids, never hex; labels carry per-language text.",
      "properties": {
        "brand": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mark"
          ],
          "properties": {
            "mark": {
              "type": "string",
              "minLength": 1
            },
            "subtitle": {
              "type": "object",
              "required": [
                "en"
              ],
              "properties": {
                "en": {
                  "type": "string"
                },
                "vi": {
                  "type": "string"
                }
              }
            }
          }
        },
        "languages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "en",
              "vi"
            ]
          }
        },
        "theme": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "categoryTabs": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "overview",
              "characters",
              "objects",
              "vfx",
              "audio",
              "review",
              "jobs",
              "sandbox",
              "atlas"
            ]
          }
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "href",
              "tab",
              "label"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$"
              },
              "href": {
                "type": "string",
                "minLength": 1
              },
              "tab": {
                "enum": [
                  "overview",
                  "characters",
                  "objects",
                  "vfx",
                  "audio",
                  "review",
                  "jobs",
                  "sandbox",
                  "atlas"
                ]
              },
              "label": {
                "type": "object",
                "required": [
                  "en"
                ],
                "properties": {
                  "en": {
                    "type": "string"
                  },
                  "vi": {
                    "type": "string"
                  }
                }
              },
              "note": {
                "type": "object",
                "required": [
                  "en"
                ],
                "properties": {
                  "en": {
                    "type": "string"
                  },
                  "vi": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "tabs": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "overview",
              "characters",
              "objects",
              "vfx",
              "audio",
              "review",
              "jobs",
              "sandbox",
              "atlas"
            ]
          },
          "properties": {
            "sandbox": {
              "type": "object",
              "description": "The Sandbox tab: where this project keeps its scene documents.",
              "properties": {
                "scenesDir": {
                  "$ref": "#/$defs/path",
                  "description": "Project-relative directory holding <id>.scene.json files (studio.scene documents). The Sandbox lists, opens and saves scenes here and nowhere else."
                }
              },
              "required": [
                "scenesDir"
              ],
              "additionalProperties": false
            }
          },
          "additionalProperties": {
            "type": "object"
          },
          "description": "Free-form per-destination configuration, one object per tab id. Each tab documents and validates its own object (see its README); the pack schema only fixes that it is an object."
        },
        "vfx": {
          "type": "object",
          "additionalProperties": false,
          "description": "VFX tab settings: the floor colours effects are judged on, the spec-history directory and the two documents that record audits. Every key is optional; without them the tab shows one neutral floor and skips the history and the recorded audits.",
          "properties": {
            "floors": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "color"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9_-]+$"
                  },
                  "color": {
                    "type": "string",
                    "pattern": "^[a-z0-9_]+$",
                    "description": "Palette colour id."
                  },
                  "joint": {
                    "type": "string",
                    "pattern": "^[a-z0-9_]+$",
                    "description": "Palette colour id for the joint lines of a tiled floor."
                  }
                }
              }
            },
            "roundsDir": {
              "$ref": "#/$defs/path",
              "description": "Directory holding round<N>/ spec history."
            },
            "rubricDoc": {
              "$ref": "#/$defs/path",
              "description": "Markdown write-up holding the core effects' self-score table."
            },
            "effectsDoc": {
              "$ref": "#/$defs/path",
              "description": "Markdown write-up holding the design-manifest effects' self-scores."
            },
            "coreSpecDir": {
              "$ref": "#/$defs/path",
              "description": "Directory holding the committed specs of the vfx-index effects (spec history lives under roundsDir)."
            },
            "rounds": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1
              },
              "description": "Round numbers of the spec history."
            },
            "effectsRawDir": {
              "$ref": "#/$defs/path",
              "description": "Directory holding the design-manifest effects' raw material: <id>/specs, <id>/provenance.json."
            },
            "effectsProcessedDir": {
              "$ref": "#/$defs/path",
              "description": "Directory of the design-manifest effects' processed frames when the manifest names no vfx.paths.processed."
            }
          }
        }
      }
    },
    "serve": {
      "type": "object",
      "additionalProperties": false,
      "description": "How the dev server exposes the project beyond the studio itself: static overlays, URL aliases, page rewrites and project-side request hooks. All optional.",
      "properties": {
        "mounts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "url",
              "dir"
            ],
            "description": "Files in `dir` answer under `url` when the studio itself has no file there (a project's own pages keep working at URLs below /studio/).",
            "properties": {
              "url": {
                "type": "string",
                "pattern": "^/[A-Za-z0-9_.-][A-Za-z0-9_./-]*/$"
              },
              "dir": {
                "$ref": "#/$defs/path"
              }
            }
          }
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "to"
            ],
            "properties": {
              "from": {
                "type": "string",
                "pattern": "^/[A-Za-z0-9_.-]+$"
              },
              "to": {
                "type": "string",
                "pattern": "^/[A-Za-z0-9_./-]*$"
              }
            }
          }
        },
        "pages": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "query",
              "serve"
            ],
            "description": "Serve another page for `path` when a query parameter has one of the listed values.",
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^/"
              },
              "query": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "serve": {
                "type": "string",
                "pattern": "^/"
              }
            }
          }
        },
        "hooks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "module"
            ],
            "description": "A project-side module exporting handle(req, res, {root, pack}) answers GET path.",
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^/"
              },
              "module": {
                "$ref": "#/$defs/path"
              }
            }
          }
        }
      }
    },
    "info": {
      "type": "object",
      "additionalProperties": false,
      "description": "Facts studio_project_info reports that no other pack block carries: the written outline and alpha rules, the atlas key groups and how a frame file is named.",
      "properties": {
        "outline": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "widthPx": {
              "type": "integer",
              "minimum": 1
            },
            "appliesToCategories": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "exemptCategories": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "note": {
              "type": "string"
            },
            "source": {
              "type": "string"
            }
          }
        },
        "alpha": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "values": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "transparentPixelRgb": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "paletteOnly": {
              "type": "boolean"
            },
            "note": {
              "type": "string"
            },
            "source": {
              "type": "string"
            }
          }
        },
        "frameKeyScopes": {
          "type": "array",
          "description": "Frame-key scopes reported as written. {scope, key} are literal; {scope, frameKey} takes the template from the pack's frameKeys.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "scope"
            ],
            "properties": {
              "scope": {
                "type": "string"
              },
              "key": {
                "type": "string"
              },
              "frameKey": {
                "type": "string"
              },
              "note": {
                "type": "string"
              },
              "source": {
                "type": "string"
              },
              "pattern": {
                "type": "string"
              },
              "processedFrom": {
                "type": "string",
                "description": "Dotted path in the asset-manifest whose value is reported as `processed`."
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1
    },
    "sizeClass": {
      "type": "object",
      "properties": {
        "sizes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "min": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "max": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "square": {
          "type": "boolean"
        }
      }
    },
    "paramSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "integer",
            "number",
            "string",
            "boolean"
          ]
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "enum": {
          "type": "array",
          "minItems": 1
        },
        "pattern": {
          "type": "string",
          "minLength": 1
        },
        "default": {},
        "description": {
          "type": "string"
        }
      }
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "script",
        "args"
      ],
      "properties": {
        "script": {
          "$ref": "#/$defs/path"
        },
        "description": {
          "type": "string"
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "params": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/paramSpec"
          }
        },
        "seed": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "default": {
              "type": "integer",
              "minimum": 0
            },
            "maximum": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "timeoutSec": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "vfxAdapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interpreter",
        "clone",
        "palettes"
      ],
      "properties": {
        "interpreter": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "command"
          ],
          "properties": {
            "command": {
              "$ref": "#/$defs/path"
            },
            "args": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "clone": {
          "$ref": "#/$defs/path"
        },
        "palettes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/path"
          }
        },
        "timeoutSec": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
