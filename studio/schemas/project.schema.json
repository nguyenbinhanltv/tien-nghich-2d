{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "studio.project.schema.json",
  "title": "Studio project pack",
  "description": "Everything project-specific that the studio core, server and client read. Paths are relative to the project root.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "id",
    "name",
    "palette",
    "sizeClasses",
    "rules",
    "frameKeys",
    "directories",
    "atlasProfiles",
    "catalog",
    "editable",
    "adapters"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema": {
      "const": "studio.project"
    },
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "palette": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file"
      ],
      "properties": {
        "file": {
          "$ref": "#/$defs/path"
        }
      }
    },
    "sizeClasses": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/sizeClass"
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alpha",
        "outline"
      ],
      "properties": {
        "alpha": {
          "enum": [
            "binary"
          ]
        },
        "outline": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "color",
            "borderIsEdge"
          ],
          "properties": {
            "mode": {
              "enum": [
                "silhouette",
                "none"
              ]
            },
            "color": {
              "anyOf": [
                {
                  "const": "palette"
                },
                {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                }
              ]
            },
            "borderIsEdge": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "frameKeys": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "directories": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw",
        "processed",
        "atlases",
        "revisions"
      ],
      "properties": {
        "raw": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/path"
          }
        },
        "processed": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/path"
          }
        },
        "atlases": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/path"
          }
        },
        "fixtures": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/path"
          }
        },
        "approvals": {
          "$ref": "#/$defs/path",
          "description": "Optional directory of tracked, hash-tied records of human approvals stated outside the studio (art_approvals.json). The Review tab reads it and never writes it."
        },
        "revisions": {
          "type": "string",
          "pattern": "^[a-z0-9._-]+$",
          "description": "Single lower-case directory name at the project root; the server hides it and the store refuses it as a library."
        }
      }
    },
    "atlasProfiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "limit",
          "padding",
          "extrude",
          "fixedSize"
        ],
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1
          },
          "padding": {
            "type": "integer",
            "minimum": 0
          },
          "extrude": {
            "type": "integer",
            "minimum": 0
          },
          "fixedSize": {
            "type": "boolean"
          }
        }
      }
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sources"
      ],
      "properties": {
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "file"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9_]+$"
              },
              "kind": {
                "enum": [
                  "asset-manifest",
                  "design-manifest",
                  "vfx-index",
                  "audio-plan"
                ]
              },
              "file": {
                "$ref": "#/$defs/path"
              },
              "effects": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_]+(\\.[A-Za-z0-9_]+)*$"
              },
              "processed": {
                "type": "string",
                "description": "Key into directories.processed holding this source's processed frames."
              },
              "budget": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "ceilings",
                  "page",
                  "bytesPerPixel",
                  "manifest"
                ],
                "description": "Per-chunk atlas budget of a design-manifest: dotted paths to the ceilings, page size and bytes per pixel, and a {chunk} template for each chunk's atlas manifest.",
                "properties": {
                  "ceilings": {
                    "type": "string"
                  },
                  "page": {
                    "type": "string"
                  },
                  "bytesPerPixel": {
                    "type": "string"
                  },
                  "manifest": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "atlas": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "dir",
                  "frameKey"
                ],
                "description": "Where a vfx-index finds its packed atlases (hash-format JSON) and which frameKeys template names its frames.",
                "properties": {
                  "dir": {
                    "$ref": "#/$defs/path"
                  },
                  "frameKey": {
                    "type": "string"
                  }
                }
              },
              "evidence": {
                "type": "object",
                "additionalProperties": false,
                "description": "Where an audio-plan finds packed packs (*/pack.json), authored masters, and per-batch source folders (named like the master's folder) for provenance pointers.",
                "properties": {
                  "packs": {
                    "$ref": "#/$defs/path"
                  },
                  "masters": {
                    "$ref": "#/$defs/path"
                  },
                  "sources": {
                    "$ref": "#/$defs/path"
                  }
                }
              },
              "label": {
                "type": "object",
                "required": [
                  "en"
                ],
                "properties": {
                  "en": {
                    "type": "string"
                  },
                  "vi": {
                    "type": "string"
                  }
                }
              },
              "effectsLabel": {
                "type": "object",
                "required": [
                  "en"
                ],
                "properties": {
                  "en": {
                    "type": "string"
                  },
                  "vi": {
                    "type": "string"
                  }
                }
              },
              "raw": {
                "type": "string",
                "description": "Key into directories.raw holding this source's per-asset source folders."
              }
            }
          }
        }
      }
    },
    "editable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "overlay",
        "groups"
      ],
      "properties": {
        "overlay": {
          "$ref": "#/$defs/path"
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "kind",
              "source"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "asset-animations",
                  "vfx-descriptor",
                  "processed-frames"
                ]
              },
              "source": {
                "type": "string"
              },
              "category": {
                "type": "string"
              },
              "frameKey": {
                "type": "string"
              },
              "raw": {
                "type": "string"
              },
              "processed": {
                "type": "string"
              },
              "categories": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                },
                "description": "processed-frames: only catalog entries of these categories (default: all of the source)."
              },
              "keyPrefix": {
                "type": "string",
                "description": "processed-frames: prepended to each frame key."
              },
              "keyMap": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "processed-frames: rename the first directory of the processed path in the key (e.g. the atlas key group)."
              },
              "pivot": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "from"
                ],
                "description": "processed-frames: default pivot; falls back to the frame centre.",
                "properties": {
                  "from": {
                    "enum": [
                      "center",
                      "file",
                      "profile"
                    ]
                  },
                  "file": {
                    "type": "string"
                  },
                  "field": {
                    "type": "string"
                  }
                }
              },
              "publish": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "mode"
                ],
                "description": "Whether an approved revision can be published into atlases. mode \"none\" must say why.",
                "properties": {
                  "mode": {
                    "enum": [
                      "atlas",
                      "none"
                    ]
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    "agentGuidance": {
      "description": "Text for agents, kept in the pack so the studio holds no project wording: pixel-art rules sent at MCP initialize, and the style words of image-sheet prompts.",
      "type": "object",
      "additionalProperties": false,
      "required": ["rules"],
      "properties": {
        "rules": {"type": "array", "minItems": 1, "maxItems": 24, "items": {"type": "string", "minLength": 1, "maxLength": 400}},
        "prompt": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "style": {"type": "string", "maxLength": 400},
            "camera": {"type": "string", "maxLength": 200},
            "light": {"type": "string", "maxLength": 200}
          }
        }
      }
    },
    "references": {
      "description": "Style-locked entities: an approved image and a description paragraph that studio_template_get hands out and every sheet prompt for these assets must carry verbatim. One entry may cover a family of assets.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["assets", "image", "sha256", "description", "approved"],
        "properties": {
          "assets": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "image": {"$ref": "#/$defs/path"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "description": {"type": "string", "minLength": 20, "maxLength": 2000},
          "approved": {
            "type": "object",
            "additionalProperties": false,
            "required": ["by", "at"],
            "properties": {"by": {"type": "string", "minLength": 1}, "at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}, "note": {"type": "string"}}
          }
        }
      }
    },
    "figures": {
      "description": "Readability guides for characters at native size: what the sheet template shows the artist and what studio_process checks. Keyed by a guide name; each lists the manifest profiles it applies to. Optional.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["profiles", "headToBody", "minLimbWidthPx", "accentMinPixels"],
        "properties": {
          "description": {"type": "string"},
          "measured": {"type": "string", "description": "Where the numbers come from (which shipped assets were measured)."},
          "profiles": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "headToBody": {
            "type": "object",
            "additionalProperties": false,
            "required": ["min", "max", "target"],
            "properties": {"min": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}, "max": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}, "target": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}}
          },
          "minLimbWidthPx": {"type": "integer", "minimum": 1, "maximum": 16},
          "accentMinPixels": {"type": "integer", "minimum": 1, "maximum": 64},
          "guide": {
            "type": "object",
            "additionalProperties": false,
            "required": ["headWidth", "bodyWidth", "legWidth", "legGap"],
            "properties": {"headWidth": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}, "bodyWidth": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}, "legWidth": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}, "legGap": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}}
          }
        }
      }
    },
    "adapters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interpreter",
        "commands"
      ],
      "properties": {
        "interpreter": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "command"
          ],
          "properties": {
            "command": {
              "$ref": "#/$defs/path"
            },
            "args": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "commands": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "script"
            ],
            "properties": {
              "script": {
                "$ref": "#/$defs/path"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "generators": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/generator"
          }
        },
        "vfx": {
          "$ref": "#/$defs/vfxAdapter"
        }
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "brand",
        "theme",
        "categoryTabs",
        "tools"
      ],
      "description": "Look and navigation of the studio shell. Colours are palette ids, never hex; labels carry per-language text.",
      "properties": {
        "brand": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mark"
          ],
          "properties": {
            "mark": {
              "type": "string",
              "minLength": 1
            },
            "subtitle": {
              "type": "object",
              "required": [
                "en"
              ],
              "properties": {
                "en": {
                  "type": "string"
                },
                "vi": {
                  "type": "string"
                }
              }
            }
          }
        },
        "languages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "en",
              "vi"
            ]
          }
        },
        "theme": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "categoryTabs": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "overview",
              "characters",
              "objects",
              "vfx",
              "audio",
              "review",
              "jobs",
              "sandbox",
              "atlas"
            ]
          }
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "href",
              "tab",
              "label"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$"
              },
              "href": {
                "type": "string",
                "minLength": 1
              },
              "tab": {
                "enum": [
                  "overview",
                  "characters",
                  "objects",
                  "vfx",
                  "audio",
                  "review",
                  "jobs",
                  "sandbox",
                  "atlas"
                ]
              },
              "label": {
                "type": "object",
                "required": [
                  "en"
                ],
                "properties": {
                  "en": {
                    "type": "string"
                  },
                  "vi": {
                    "type": "string"
                  }
                }
              },
              "note": {
                "type": "object",
                "required": [
                  "en"
                ],
                "properties": {
                  "en": {
                    "type": "string"
                  },
                  "vi": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "tabs": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "overview",
              "characters",
              "objects",
              "vfx",
              "audio",
              "review",
              "jobs",
              "sandbox",
              "atlas"
            ]
          },
          "properties": {
            "sandbox": {
              "type": "object",
              "description": "The Sandbox tab: where this project keeps its scene documents.",
              "properties": {
                "scenesDir": {
                  "$ref": "#/$defs/path",
                  "description": "Project-relative directory holding <id>.scene.json files (studio.scene documents). The Sandbox lists, opens and saves scenes here and nowhere else."
                }
              },
              "required": ["scenesDir"],
              "additionalProperties": false
            }
          },
          "additionalProperties": {
            "type": "object"
          },
          "description": "Free-form per-destination configuration, one object per tab id. Each tab documents and validates its own object (see its README); the pack schema only fixes that it is an object."
        },
        "vfx": {
          "type": "object",
          "additionalProperties": false,
          "description": "VFX tab settings: the floor colours effects are judged on, the spec-history directory and the two documents that record audits. Every key is optional; without them the tab shows one neutral floor and skips the history and the recorded audits.",
          "properties": {
            "floors": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "color"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9_-]+$"
                  },
                  "color": {
                    "type": "string",
                    "pattern": "^[a-z0-9_]+$",
                    "description": "Palette colour id."
                  },
                  "joint": {
                    "type": "string",
                    "pattern": "^[a-z0-9_]+$",
                    "description": "Palette colour id for the joint lines of a tiled floor."
                  }
                }
              }
            },
            "roundsDir": {
              "$ref": "#/$defs/path",
              "description": "Directory holding round<N>/ spec history."
            },
            "rubricDoc": {
              "$ref": "#/$defs/path",
              "description": "Markdown write-up holding the core effects' self-score table."
            },
            "longtimeDoc": {
              "$ref": "#/$defs/path",
              "description": "Markdown write-up holding the design-manifest effects' self-scores."
            }
          }
        }
      }
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1
    },
    "sizeClass": {
      "type": "object",
      "properties": {
        "sizes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "min": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "max": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "square": {
          "type": "boolean"
        }
      }
    },
    "paramSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "integer",
            "number",
            "string",
            "boolean"
          ]
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "enum": {
          "type": "array",
          "minItems": 1
        },
        "pattern": {
          "type": "string",
          "minLength": 1
        },
        "default": {},
        "description": {
          "type": "string"
        }
      }
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "script",
        "args"
      ],
      "properties": {
        "script": {
          "$ref": "#/$defs/path"
        },
        "description": {
          "type": "string"
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "params": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/paramSpec"
          }
        },
        "seed": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "default": {
              "type": "integer",
              "minimum": 0
            },
            "maximum": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "timeoutSec": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "vfxAdapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interpreter",
        "clone",
        "palettes"
      ],
      "properties": {
        "interpreter": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "command"
          ],
          "properties": {
            "command": {
              "$ref": "#/$defs/path"
            },
            "args": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "clone": {
          "$ref": "#/$defs/path"
        },
        "palettes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/path"
          }
        },
        "timeoutSec": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
